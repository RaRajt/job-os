                  {
                      "id":  "n7",
                      "name":  "Rules: find details, build Doc text",
                      "type":  "n8n-nodes-base.code",
                      "typeVersion":  2,
                      "position":  [
                                       1100,
                                       0
                                   ],
                      "parameters":  {
                                         "mode":  "runOnceForEachItem",
                                         "jsCode":  "// Runs once per job. Plain rules only, no AI.\nconst row = $(\u0027Only new rows\u0027).item.json;          // the original sheet row\nconst url = String(row[\u0027Job URL\u0027] || \u0027\u0027).trim();\nconst h = $json;                                     // what the HTML step found\n\n// 1. Clean up title, JD and full page text\nconst title = String(h.title || \u0027\u0027).replace(/\\s+/g, \u0027 \u0027).trim();\nconst jd = String(h.description || \u0027\u0027).replace(/[ \\t\\u00a0]+/g, \u0027 \u0027).replace(/\\s*\\n\\s*/g, \u0027\\n\u0027).trim();\nconst full = String(h.fulltext || \u0027\u0027).replace(/\\s+/g, \u0027 \u0027).trim();\n\n// 2. Company: read it from the web address\nlet host = \u0027\u0027, path = [];\nconst m = url.match(/^https?:\\/\\/([^\\/?#]+)([^?#]*)/i);   // cut the link into: website name + the path after it\nif (m) { host = m[1].toLowerCase().replace(/^www\\./, \u0027\u0027); path = m[2].split(\u0027/\u0027).filter(Boolean); }\nconst skip = [\u0027careers\u0027, \u0027career\u0027, \u0027jobs\u0027, \u0027job\u0027, \u0027apply\u0027, \u0027boards\u0027, \u0027en\u0027, \u0027in\u0027, \u0027www\u0027];\nlet company = host.split(\u0027.\u0027).find(p =\u003e !skip.includes(p)) || \u0027\u0027;\nconst jobBoards = [\u0027greenhouse.io\u0027, \u0027lever.co\u0027, \u0027ashbyhq.com\u0027, \u0027workable.com\u0027, \u0027smartrecruiters.com\u0027];\nif (jobBoards.some(b =\u003e host.endsWith(b))) company = path[0] || company;   // company name sits in the path\ncompany = company.length \u003c= 3 ? company.toUpperCase() : company.charAt(0).toUpperCase() + company.slice(1);\n\n// 3. Source: where did the link come from?\nconst low = url.toLowerCase();\nlet source = \u0027Company site\u0027;\nif (host.includes(\u0027linkedin\u0027)) source = \u0027LinkedIn\u0027;\nelse if (host.includes(\u0027naukri\u0027)) source = \u0027Naukri\u0027;\nelse if (host.includes(\u0027indeed\u0027)) source = \u0027Indeed\u0027;\nelse if (low.includes(\u0027utm_source=linkedin\u0027)) source = \u0027Company site (via LinkedIn)\u0027;\n\n// 4. Dates: look for date words followed by a date\nconst datePattern = /(posted on|posted|posting date|date posted|apply by|deadline|closing date|last date)[^.]{0,30}?(\\d{1,2}[\\/.-]\\d{1,2}[\\/.-]\\d{2,4}|\\d{4}-\\d{2}-\\d{2}|\\d{1,2}\\s+[A-Za-z]{3,9},?\\s+\\d{4}|[A-Za-z]{3,9}\\s+\\d{1,2},?\\s+\\d{4})/gi;\nconst found = [...full.matchAll(datePattern)].map(m =\u003e m[1] + \u0027: \u0027 + m[2]);\nconst dates = full.length \u003c= 200 ? \u0027\u0027 : (found.length ? [...new Set(found)].join(\u0027; \u0027) : \u0027No dates mentioned\u0027);\n\n// 5. Today\u0027s date in India time\nconst date_added = DateTime.now().setZone(\u0027Asia/Kolkata\u0027).toFormat(\u0027dd-MMM-yyyy\u0027);\n\n// 6a. Work type: look for the words in the page text\nconst lowText = (jd + \u0027 \u0027 + full).toLowerCase();\nconst work_type = /\\bhybrid\\b/.test(lowText) ? \u0027Hybrid\u0027\n                : /\\bremote\\b|work from home|wfh/.test(lowText) ? \u0027Remote\u0027\n                : /on-?site|in-office|work from office/.test(lowText) ? \u0027Onsite\u0027 : \u0027\u0027;\n\n// 6b. Location: first try a \"Location: ...\" label, else look for known cities\nlet location = \u0027\u0027;\nconst lm = full.match(/(?:job )?location[s]?\\s*[:\\-]\\s*([A-Za-z ,.\\-()]{2,60})/i);\nif (lm) location = lm[1].replace(/\\s+(other locations|apply|posted|date|job|requisition).*$/i, \u0027\u0027).trim();\nelse {\n  const cities = [\u0027Mumbai\u0027,\u0027Pune\u0027,\u0027Bengaluru\u0027,\u0027Bangalore\u0027,\u0027Hyderabad\u0027,\u0027Chennai\u0027,\u0027Gurugram\u0027,\u0027Gurgaon\u0027,\u0027Noida\u0027,\u0027Delhi\u0027,\u0027Kolkata\u0027,\u0027Ahmedabad\u0027,\u0027Dubai\u0027,\u0027London\u0027,\u0027Sydney\u0027,\u0027Melbourne\u0027,\u0027New York\u0027,\u0027Singapore\u0027];\n  const hit = cities.filter(c =\u003e full.includes(c));\n  location = [...new Set(hit)].slice(0, 3).join(\u0027, \u0027);\n}\n\n// 6. Decide the status: what did the rules manage to find?\nconst missing = [];\nif (!company) missing.push(\u0027company\u0027);\nif (!title) missing.push(\u0027title\u0027);\nif (!jd) missing.push(\u0027JD\u0027);\nconst pageOk = full.length \u003e 200;\nconst jd_status = !pageOk ? \u0027check: page did not open\u0027\n                : missing.length ? \u0027check: \u0027 + missing.join(\u0027, \u0027) + \u0027 not found\u0027\n                : \u0027complete\u0027;\n\n// 7. Build the Doc: found details on top, then the JD (or page text if no JD)\nconst NF = \u0027Not found - check\u0027;\nconst body = jd ? \u0027--- JOB DESCRIPTION ---\\n\u0027 + jd\n           : pageOk ? \u0027--- FULL PAGE TEXT (JD not found, pick it out) ---\\n\u0027 + full.slice(0, 45000)\n           : \u0027--- Page did not open. Paste the JD here yourself. ---\u0027;\nconst doc_text = [\n  \u0027Company: \u0027 + (company || NF),\n  \u0027Job Title: \u0027 + (title || NF),\n  \u0027Job URL: \u0027 + url,\n  \u0027Source: \u0027 + source,\n  \u0027Work Type: \u0027 + (work_type || NF),\n  \u0027Location: \u0027 + (location || NF),\n  \u0027Dates: \u0027 + (dates || NF),\n  \u0027Rules result: \u0027 + jd_status,\n  \u0027Date Added: \u0027 + date_added,\n  \u0027\u0027, body].join(\u0027\\n\u0027);\nconst doc_name = (company || host || \u0027Unknown\u0027) + \u0027 - \u0027 + (title || \u0027Title not found\u0027) + \u0027 - \u0027 + date_added;\n\nreturn { json: { row_number: row.row_number, company: company || NF, title: title || NF,\n                 work_type: work_type || NF, location: location || NF,\n                 source, date_added, page_ok: pageOk, doc_text, doc_name } };\n"
                                     }
                  },
